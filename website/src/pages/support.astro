---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { project } from '@/config/project.config';
import { withBase } from '@/lib/base';
import '@/styles/project.css';
---

<LandingLayout title="Support" description={`Get help setting up and using ${project.name}.`}>
  <main id="main-content" class="project-site doc-page">
    <div class="project-shell">
      <article>
        <div class="section-kicker">SUPPORT</div>
        <h1>Support</h1>
        <p>Install <a href={project.feishinUrl}>Feishin</a> on your computer, open <strong>Settings → Window</strong>, and enable <strong>Remote control server</strong>. Enter the computer's address in the app, for example <code>http://192.168.1.20:4333</code>, along with any username and password you set.</p>
        <p>Both devices must be on the same network. Library browsing, playlist actions, radio and queue management need Feishin 1.16.0 or newer. Earlier versions support basic playback controls.</p>

        <h2>Guides</h2>
        <ul>
          <li><a href={withBase('/docs/getting-started/')}>Getting started</a>: enable Remote, install the app, and connect.</li>
          <li><a href={withBase('/docs/using-the-app/')}>Using the app</a>: playback, the library, playlists, radio and the queue.</li>
          <li><a href={withBase('/docs/troubleshooting/')}>Troubleshooting</a>: what to check when the app does not connect.</li>
        </ul>

        <h2>Report a problem</h2>
        <p><a href={project.issuesUrl}>Open an issue on GitHub</a> with your Android version, your Feishin version, and what you tried.</p>
      </article>
    </div>
  </main>
</LandingLayout>
