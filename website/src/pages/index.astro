---
import Site from "../layouts/Site.astro";
import project from "../../../project.json";

const asset = (name: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/media/${name}`;
const repository = import.meta.env.PUBLIC_REPOSITORY;
const download = project.downloadUrl ||
  (repository ? `https://github.com/${repository}/releases/latest` : "");
const features = [
  ["Now Playing", "Artwork, favorites, ratings, volume, shuffle and repeat for whatever your computer is playing."],
  ["Search and browse", "Find tracks, albums, playlists and internet radio, then play now, next or last."],
  ["Live queue", "See the desktop queue, jump to a track, reorder, remove or clear it."],
  ["Android media controls", "Notification, lock screen, headset and Bluetooth buttons control Feishin."],
];
---
<Site>
  <section class="intro">
    <div>
      <h1>{project.name}</h1>
      <p>{project.description} Audio keeps playing on your computer; your phone becomes the remote.</p>
      {download && <a class="button" href={download}>Download the APK</a>}
      <p class="note">Needs Feishin desktop with Remote enabled. Library browsing and queue tools need Feishin 1.16.0 or newer.</p>
    </div>
    <figure>
      <img src={asset("playing.webp")} alt="Now Playing with artwork, favorite, rating and transport controls" width="800" height="1760" />
      <img src={asset("library.webp")} alt="Searchable track list with a mini player and navigation bar" width="800" height="1760" />
      <img src={asset("queue.webp")} alt="The live desktop queue with the current track highlighted" width="800" height="1760" />
    </figure>
  </section>
  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title">What it does</h2>
    <ul>
      {features.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
    </ul>
  </section>
  <section class="tour" aria-labelledby="tour-title">
    <div>
      <h2 id="tour-title">See how it works</h2>
      <p>Check what is playing, search the library, then manage the queue.</p>
    </div>
    <video controls playsinline preload="none" poster={asset("tour-poster.webp")} aria-label="Silent walkthrough of the app">
      <source src={asset("tour.mp4")} type="video/mp4" />
      <a href={asset("tour.mp4")}>Download the walkthrough</a>
    </video>
  </section>
</Site>

<style>
  .intro, .tour { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  h1, h2 { font-weight: 700; line-height: 1; letter-spacing: -0.04em; margin: 0; }
  h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
  h2 { font-size: clamp(2rem, 4.5vw, 3rem); }
  h3 { margin: 0 0 .35rem; font-size: 1.1rem; }
  p { max-width: 34ch; font-size: 1.1rem; line-height: 1.55; }
  .note { font-size: .95rem; color: #bdb4a3; }
  .button { display: inline-block; padding: .85rem 1.2rem; border-radius: .5rem; color: #261c05; background: #e9b44c; font-weight: 650; text-decoration: none; }
  figure { display: grid; grid-template-columns: repeat(3, 1fr); align-items: start; gap: .75rem; margin: 0; padding: clamp(.75rem, 3vw, 1.5rem); border-radius: 1.5rem; background: #202328; }
  img, video { display: block; max-width: 100%; border-radius: .85rem; box-shadow: 0 0 0 1px #ffffff1f; }
  img { width: 100%; height: auto; }
  figure img:nth-child(2) { margin-top: 1.5rem; }
  .features { margin-top: clamp(3rem, 9vw, 6rem); }
  .features ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .features li { padding: 1.25rem; border-radius: 1rem; background: #202328; }
  .features p { margin: 0; font-size: 1rem; }
  .tour { margin-top: clamp(3rem, 9vw, 6rem); padding: clamp(1rem, 5vw, 3rem); border-radius: 1.5rem; background: #202328; }
  video { width: min(100%, 17rem); margin-inline: auto; background: #15171a; }
  @media (max-width: 43rem) { .intro, .tour { grid-template-columns: 1fr; } }
</style>
