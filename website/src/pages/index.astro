---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { project } from '@/config/project.config';
import { withBase } from '@/lib/base';
import '@/styles/project.css';

/** App captures written by `tool/media.sh` into `public/media/`. */
const media = (file: string) => withBase(`/media/${file}`);
const [hero, ...gallery] = project.screenshots;
---

<LandingLayout title={project.name} description={project.description}>
  <main id="main-content" class="project-site">
    <section class="project-hero" aria-labelledby="project-title">
      <div class="project-glow" aria-hidden="true"></div>
      <div class="project-shell hero-grid">
        <div class="hero-content">
          <div class="project-eyebrow"><span class="eyebrow-dot"></span>{project.eyebrow}</div>
          <h1 id="project-title">{project.headline}</h1>
          <p class="hero-summary">{project.summary}</p>
          <div class="hero-actions">
            <a class="project-button primary" href={project.downloadUrl}>Download the APK <Icon name="download" size="sm" /></a>
            <a class="project-button secondary" href={withBase('/docs/getting-started/')}>Set it up <Icon name="arrow-up-right" size="sm" /></a>
          </div>
          <div class="hero-meta"><span class="status-dot"></span> {project.versionLabel} <span aria-hidden="true">/</span> Android <span aria-hidden="true">/</span> No tracking</div>
          <p class="hero-note">{project.requirement}</p>
        </div>
        <div class="phone-stack">
          {gallery.map((shot) => (
            <img class="phone-shot back" src={media(shot.file)} alt="" width="800" height="1760" loading="eager" decoding="async" />
          ))}
          <img class="phone-shot front" src={media(hero.file)} alt={hero.alt} width="800" height="1760" loading="eager" decoding="async" fetchpriority="high" />
        </div>
      </div>
      <div class="project-shell hero-bottom"><span>AUDIO STAYS ON YOUR COMPUTER</span><span>01 / OVERVIEW</span></div>
    </section>

    <section id="features" class="project-section" aria-labelledby="features-title">
      <div class="project-shell">
        <div class="section-kicker">WHAT IT DOES</div>
        <div class="section-heading"><h2 id="features-title">Everything Feishin does,<br /><em>in your pocket.</em></h2><p>Control playback, find something new to play, and shape the queue without walking back to your computer.</p></div>
        <div class="feature-grid">
          {project.benefits.map((benefit) => (
            <article class="feature-card">
              <div class="feature-top"><span>{benefit.number}</span><span class="feature-icon"><Icon name={benefit.icon} size="lg" /></span></div>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="tour" class="project-section section-alt" aria-labelledby="tour-title">
      <div class="project-shell">
        <div class="section-kicker">SEE IT WORK</div>
        <div class="section-heading"><h2 id="tour-title">Playing, library,<br /><em>and the live queue.</em></h2><p>Captured from the real app, connected to a demo Feishin library.</p></div>
        <div class="tour-grid">
          <figure class="tour-video">
            <video controls playsinline preload="none" poster={media('tour-poster.webp')} aria-label="Silent walkthrough of the app" width="600" height="1320">
              <source src={media('tour.mp4')} type="video/mp4" />
              <a href={media('tour.mp4')}>Download the walkthrough</a>
            </video>
            <figcaption>Walkthrough, no sound</figcaption>
          </figure>
          {gallery.map((shot) => (
            <figure class="tour-shot">
              <img src={media(shot.file)} alt={shot.alt} width="800" height="1760" loading="lazy" decoding="async" />
              <figcaption>{shot.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="setup" class="project-section" aria-labelledby="setup-title">
      <div class="project-shell workflow-grid">
        <div>
          <div class="section-kicker">SETUP</div>
          <h2 id="setup-title">Connected in<br />three steps.</h2>
          <p class="section-lead">Your phone and computer need to be on the same network. Feishin's Remote listens on port 4333 by default.</p>
          <a class="project-text-link" href={withBase('/docs/getting-started/')}>Read the setup guide <Icon name="arrow-up-right" size="sm" /></a>
        </div>
        <ol class="workflow-steps">
          {project.steps.map((step, index) => (
            <li class="workflow-step"><span class="step-number">0{index + 1}</span><div><h3>{step.label}</h3><p>{step.detail}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="faq" class="project-section section-alt" aria-labelledby="faq-title">
      <div class="project-shell faq-grid"><div><div class="section-kicker">QUESTIONS</div><h2 id="faq-title">Good to know.</h2><p class="section-lead">Short answers here. More in the <a href={withBase('/docs/troubleshooting/')}>troubleshooting guide</a>.</p></div><div class="faq-list">{project.faqs.map((item) => (<details><summary>{item.question}<Icon name="plus" size="sm" /></summary><p>{item.answer}</p></details>))}</div></div>
    </section>

    <section class="project-final-cta" aria-labelledby="start-title"><div class="project-shell final-inner"><span class="section-kicker">GET THE APP</span><h2 id="start-title">Leave the computer.<br />Keep the music.</h2><p>Free, open source, and without accounts or tracking.</p><div class="hero-actions"><a class="project-button primary" href={project.downloadUrl}>Download the APK <Icon name="download" size="sm" /></a><a class="project-button secondary" href={project.repository} target="_blank" rel="noopener noreferrer">View source <Icon name="github" size="sm" /></a></div></div></section>
  </main>
</LandingLayout>
